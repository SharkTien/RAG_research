APP_ENV=development
JWT_SECRET_KEY=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-before-first-start
COOKIE_SECURE=false
MAX_UPLOAD_BYTES=209715200
DOCLING_DO_OCR=auto
DOCLING_DO_TABLE_STRUCTURE=false
DOCLING_DEVICE=cpu
DOCLING_NUM_THREADS=4
DOCLING_OCR_BATCH_SIZE=4
DOCLING_FORCE_FULL_PAGE_OCR=true
DOCLING_OCR_ENGINE=tesseract
DOCLING_OCR_LANG=vie,eng

POSTGRES_DB=rag
POSTGRES_USER=rag
POSTGRES_PASSWORD=change-database-password
MINIO_ROOT_USER=rag_minio
MINIO_ROOT_PASSWORD=change-minio-password

# NVIDIA NIM Configuration
NGC_API_KEY=nvapi-your-api-key-here
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=meta/llama-3.3-70b-instruct
NIM_CONCURRENCY=4
NIM_TIMEOUT_SECONDS=60
# Hugging Face Configuration (để tải model nhanh hơn & không bị cảnh báo rate limit)
HF_KEY=hf_your_token_here
HF_TOKEN=hf_your_token_here
